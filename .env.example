# Frontend
FRONTEND_PORT=80
REACT_APP_API_URL=/api
VITE_API_URL=/api
VITE_AUTH_API_URL=/auth-api

# Core service ports
BACKEND_PORT=3000
ML_PORT=5000
MONGO_PORT=27017
LLM_PORT=11434
NODE_ENV=production

# Service URLs
MONGO_URI=mongodb://mongodb:27017/mental_health
MONGO_DB_NAME=mental_health
ML_SERVICE_URL=http://ml-service:5000
LLM_API_URL=http://llm-service:11434
OLLAMA_URL=http://ollama:11434
LLM_MODEL_NAME=llama3.1

# Auth security
JWT_SECRET_KEY=replace-with-a-strong-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://frontend,http://localhost:80,http://localhost:5173

# ML runtime toggles
ENABLE_EMOTION=false
ENABLE_FACE_EMOTION=true
ML_REQUIRE_JWT=true

# Optional backend auth token behavior
ACCESS_TOKEN_EXPIRE_MINUTES=1440
